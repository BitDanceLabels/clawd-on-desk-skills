{
  "name": "clawd-on-desk",
  "productName": "JAVIS",
  "version": "0.13.1",
  "description": "JAVIS — bé trợ lý hologram trên máy tính: nói hoặc gõ, JAVIS hiện việc, máy, kho tài sản, cảnh báo, số liệu kênh, dòng tiền ngay cạnh; báo khi có việc cần anh.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && node launch.js",
    "dev": "npm run build:renderer && cross-env CLAWD_DEVTOOLS=1 ELECTRON_ENABLE_LOGGING=1 node launch.js",
    "build:renderer": "node scripts/build-renderer-bundles.js",
    "build": "npm run build:renderer && electron-builder --win --publish never",
    "build:mac": "npm run build:renderer && electron-builder --mac --publish never",
    "build:linux": "npm run build:renderer && electron-builder --linux --publish never",
    "build:all": "npm run build:renderer && electron-builder --win --mac --linux --publish never",
    "test": "node --test test/*.test.js",
    "install:gemini-hooks": "node hooks/gemini-install.js",
    "install:cursor-hooks": "node hooks/cursor-install.js",
    "make:icons": "node scripts/make-icons.js",
    "release": "bash scripts/publish-desk-release.sh"
  },
  "keywords": [
    "javis",
    "desktop-assistant",
    "hologram",
    "electron",
    "claude-code"
  ],
  "author": "rullerzhou-afk",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.clawd.on-desk",
    "productName": "JAVIS",
    "afterPack": "build/afterPack.js",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "JAVIS dùng micro khi anh bấm nút mic để nói lệnh."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "JAVIS-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "rullerzhou-afk <rullerzhou-afk@users.noreply.github.com>",
      "icon": "assets/icons",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "javis",
      "desktop": {
        "entry": {
          "Name": "JAVIS",
          "StartupWMClass": "JAVIS"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "shortcutName": "JAVIS",
      "uninstallDisplayName": "JAVIS"
    },
    "files": [
      "src/**/*",
      "!src/desk/*.js",
      "src/desk/index.html",
      "src/desk/desk.css",
      "hooks/**/*",
      "agents/**/*",
      "assets/hologram/**/*",
      "assets/javis-ask-box/**/*",
      "assets/tray-icon*.png",
      "assets/icons/**/*",
      "LICENSES.md"
    ],
    "asarUnpack": [
      "hooks/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "artifactName": "JAVIS-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "three": "^0.184.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
